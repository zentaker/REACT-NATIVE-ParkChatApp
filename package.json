{
  "name": "aldea",
  "version": "0.1.0",
  "private": true,
  "description": "Red social geoespacial donde cada lugar tiene chat publico, grupos locales y eventos espontaneos.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:web": "expo start --web --port 5000",
    "start:web:clear": "expo start --web --port 5000 --clear",
    "start:go": "expo start --tunnel",
    "start:go:clear": "expo start --tunnel --clear",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor:node": "node ./scripts/doctor-node.mjs",
    "doctor:node:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/doctor-node.ps1",
    "doctor:replit": "node ./scripts/doctor-replit.js",
    "replit:start": "node ./scripts/start-replit-expo.js web",
    "replit:web": "node ./scripts/start-replit-expo.js web",
    "replit:mobile": "node ./scripts/start-replit-expo.js mobile",
    "replit:lan": "node ./scripts/start-replit-expo.js lan",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "^8.4.1",
    "@supabase/supabase-js": "^2.106.1",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.6",
    "expo-linking": "~7.1.5",
    "expo-router": "~5.1.11",
    "expo-status-bar": "~2.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  }
}
